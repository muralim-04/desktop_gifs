{
  "manifest_version": 3,
  "name": "Desktop GIFs",
  "version": "0.1.5",
  "description": "Post Tenor GIFs in YouTube comments and replies from desktop.",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "desktop-gifs@rayytor",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://tenor.com/*", "https://www.youtube.com/*"],
  "background": {
    "service_worker": "dist/sw.js",
    "scripts": ["dist/sw.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["dist/main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["dist/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ]
}
